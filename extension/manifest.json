{
  "manifest_version": 3,
  "name": "GrammarlyLocal",
  "version": "1.0.1",
  "description": "Local, private offline grammar and spell checker powered by LanguageTool.",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "GrammarlyLocal Status"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:8081/*",
    "http://127.0.0.1:8081/*",
    "http://localhost:8082/*",
    "http://127.0.0.1:8082/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
